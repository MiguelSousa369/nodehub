generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users: technicians who sign in to the dashboard
// ---------------------------------------------------------------------------

enum Role {
  ADMIN       // everything, including managing users
  TECHNICIAN  // machines, clients and sessions
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  name         String
  passwordHash String     @map("password_hash")
  role         Role       @default(TECHNICIAN)
  active       Boolean    @default(true)
  /// Dashboard sign-ins (JWTs) issued before this are rejected: moved forward when the password changes
  sessionsValidFrom DateTime @default(now()) @map("sessions_valid_from")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  apiTokens    ApiToken[]
  cliLogins    CliLoginRequest[]
  sessions     Session[]
  sshKeys      SshKey[]

  @@map("users")
}

/// A connected PC: the access token the nodehub CLI (and therefore Claude Code) uses on one
/// computer. Created by the browser authorisation flow (`nodehub login`), one per PC.
/// Only a SHA-256 hash is stored.
model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    // PC name reported by the CLI, e.g. MIGUEL-LAPTOP
  prefix     String    // first characters, to recognise the token
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@index([userId])
  @@map("api_tokens")
}

enum CliLoginStatus {
  PENDING   // waiting for someone to approve it in the dashboard
  APPROVED  // approved; the CLI collects its token on the next poll
  DENIED
  CONSUMED  // token already handed to the CLI
}

/// Browser authorisation of a PC (device authorisation flow, like `gh auth login`).
/// The CLI keeps the secret device code and polls with it; the user approves the short
/// user code in the dashboard. Requests expire after a few minutes.
model CliLoginRequest {
  id             Int            @id @default(autoincrement())
  deviceCodeHash String         @unique @map("device_code_hash")
  userCode       String         @unique @map("user_code")
  deviceName     String         @map("device_name")
  status         CliLoginStatus @default(PENDING)
  userId         Int?           @map("user_id")
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("cli_login_requests")
}

// ---------------------------------------------------------------------------
// Clients and their machines (Tailscale state is read live, not stored)
// ---------------------------------------------------------------------------

model Client {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  notes     String    @default("")
  createdAt DateTime  @default(now()) @map("created_at")
  machines  Machine[]

  @@map("clients")
}

model Machine {
  host      String   @id // unique name in the tailnet
  clientId  Int      @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sshUser   String   @default("nodehub") @map("ssh_user")
  /// Friendly name for the team (e.g. "PC-PEDRO"); empty = show the tailnet name
  displayName String @default("") @map("display_name")
  notes     String   @default("")
  /// Free-form profile in Markdown: role, OS, hardware, important software, quirks.
  profile   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("machines")
}

// ---------------------------------------------------------------------------
// Helpdesk sessions: what was done on each machine, by whom
// ---------------------------------------------------------------------------

enum SessionResult {
  FIXED
  PARTIAL
  UNRESOLVED
}

/// Linked to the machine by host name (not a foreign key) so the history
/// survives when a machine is removed from the dashboard and added back.
model Session {
  id           Int           @id @default(autoincrement())
  host         String
  technicianId Int?          @map("technician_id")
  technician   User?         @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  summary      String
  problem      String        @default("")
  diagnosis    String        @default("")
  actions      String        @default("")
  result       SessionResult
  pending      String        @default("")
  createdAt    DateTime      @default(now()) @map("created_at")
  /// Set when the record is corrected afterwards (nodehub update / PATCH); null = never edited
  updatedAt    DateTime?     @map("updated_at")

  @@index([host, createdAt])
  @@index([technicianId])
  @@map("sessions")
}

/// Team-wide settings, one row per key (e.g. language = en | pt). Read through settings.service.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// An SSH public key of the team: owned by a user, or a service key (no owner, created by admins).
/// Applied to client PCs (installer, nodehub keys sync) while the owner's account is active.
model SshKey {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String                     // label, e.g. "laptop" or "server test key"
  type        String                     // ssh-ed25519, ssh-rsa, ...
  body        String   @unique           // "type base64": identifies the key
  comment     String   @default("")
  fingerprint String                     // SHA256:... as ssh-keygen -l shows it
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ssh_keys")
}
