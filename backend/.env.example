# --- Server -------------------------------------------------------------------
# Optional. Port, default 8737.
PORT=8737
# Optional. Interface, default 127.0.0.1. Keep it local: the dashboard is local-only.
HOST=127.0.0.1
# Optional. development | production | test.
NODE_ENV=development
# Optional. Winston log level, default info.
LOG_LEVEL=info

# --- Auth ---------------------------------------------------------------------
# REQUIRED. Static API key the dashboard sends as "Authorization: Bearer <API_KEY>".
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# --- Client installer ---------------------------------------------------------
# Required to download the installer. Tailscale auth key: reusable, pre-approved, tagged tag:cliente.
TAILSCALE_AUTHKEY=

# --- Paths (all optional) -----------------------------------------------------
# Tailscale CLI, default C:\Program Files\Tailscale\tailscale.exe
# TAILSCALE_BIN=
# Machine configuration store, default ./data
# DATA_DIR=
# Technicians' SSH public keys (*.pub), default ../public-keys
# PUBLIC_KEYS_DIR=
# Installer template, default ../installer/install-client.ps1
# INSTALLER_TEMPLATE=
# Built dashboard served at /, default ../frontend/dist
# FRONTEND_DIST=
# CORS origin in production, default http://localhost:5173
# FRONTEND_ORIGIN=
