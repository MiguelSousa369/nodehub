# --- Server -------------------------------------------------------------------
# Optional. Port, default 8737.
PORT=8737
# Optional. Interface, default 127.0.0.1. Keep it local: the dashboard is local-only.
HOST=127.0.0.1
# Optional. development | production | test.
NODE_ENV=development
# Optional. Winston log level, default info.
LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
# REQUIRED. PostgreSQL from docker-compose.yml (docker compose up -d).
DATABASE_URL=postgresql://nodehub:nodehub@127.0.0.1:5433/nodehub
# Optional. Database used by npm test, default: DATABASE_URL with the database name nodehub_test.
# DATABASE_URL_TEST=

# --- Auth ---------------------------------------------------------------------
# REQUIRED. Secret used to sign the login tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional. Session length, default 12h.
JWT_EXPIRES_IN=12h
# Optional. First admin created by "npm run seed" (only when there are no users yet).
# Without ADMIN_PASSWORD a random one is generated and printed once.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Tailscale ----------------------------------------------------------------
# Optional. Tag that marks client machines in your tailnet, default tag:client.
# Must match the tag in your Tailscale ACL and on the auth key below.
CLIENT_TAG=tag:client
# Required to download the client installer. Auth key: reusable, pre-approved, tagged with CLIENT_TAG.
TAILSCALE_AUTHKEY=

# --- Paths (all optional) -----------------------------------------------------
# Tailscale CLI, default C:\Program Files\Tailscale\tailscale.exe
# TAILSCALE_BIN=
# Technicians' SSH public keys (*.pub), default ../public-keys
# PUBLIC_KEYS_DIR=
# Installer template, default ../installer/install-client.ps1
# INSTALLER_TEMPLATE=
# Built dashboard served at /, default ../frontend/dist
# FRONTEND_DIST=
