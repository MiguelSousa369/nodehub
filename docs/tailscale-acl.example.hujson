// Tailscale access controls for nodehub.
// Paste into https://login.tailscale.com/admin/acls (Access controls).
// If you change the tag, set CLIENT_TAG in backend/.env to the same value.
{
  "tagOwners": {
    // Only tailnet admins can create auth keys with this tag
    "tag:client": ["autogroup:admin"],
  },

  "grants": [
    // Technicians' devices can talk to each other
    {"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

    // Technicians reach client machines on SSH only
    {"src": ["autogroup:member"], "dst": ["tag:client"], "ip": ["22"]},
  ],

  // Everything else is denied: client machines can't reach the technicians,
  // and clients can't reach each other.
}
